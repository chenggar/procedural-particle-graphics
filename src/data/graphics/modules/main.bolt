function effects:torus1:
    for i in range(100):
        theta = math.pi * i / 100
        
        for j in range(100):
            phi = 2 * math.pi * j / 100

            radius1 = 3
            radius2 = 3
            x = (radius1 + radius2 * math.sin(theta)) * math.cos(phi)
            y = ((radius1 + radius2 * math.sin(theta)) * math.sin(phi)) + SPAWN_HEIGHT
            z = radius1 * math.cos(theta)

            particle nautilus ~x ~y ~z

function effects:torus2:
    for i in range(100):
